{
  "manifest_version": 3,
  "name": "易offer 网申填写助手",
  "short_name": "易offer",
  "version": "2.0.0",
  "description": "易offer网申填写助手，支持一键、增量与选区填入、多简历管理和投递跟进。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "打开易offer网申填写助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "scripts/profile-schema.js",
        "scripts/content/profile-catalog.js",
        "scripts/content/core.js",
        "scripts/content/detector.js",
        "scripts/content/control-adapters.js",
        "scripts/content/site.js",
        "scripts/content/structure.js",
        "scripts/content/smart-fill.js",
        "scripts/content/fill-engine.js",
        "scripts/content/ai.js",
        "scripts/content/region.js",
        "scripts/content/region-yanyu.js",
        "scripts/content/dock.js",
        "scripts/content/dock-yanyu.js",
        "scripts/content/main.js",
        "scripts/content.js"
      ],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "vendor/pdfjs/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
